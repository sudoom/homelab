# Example contents for vars/vault.yml — DO NOT commit the real file.
#
# Create the real vault-encrypted file with:
#   cd ansible/technitium
#   ansible-vault create vars/vault.yml
#
# …and paste the contents below (with the actual admin password set on first
# UI login at http://<technitium-ip>:5380). The example file (this one) is
# committed as a template; the real vault.yml is in .gitignore.

# Technitium admin user's password — set this in the web UI on first install,
# then store the same value here under Ansible Vault.
technitium_admin_password: "REPLACE_ME"

# (optional) if non-default sudo password on the RPi
# ansible_become_password: "REPLACE_ME"
