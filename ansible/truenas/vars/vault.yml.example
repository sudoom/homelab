---
# Template for vars/vault.yml — the REAL file is vault-encrypted and gitignored.
#
#   cd ansible/truenas
#   ansible-vault create vars/vault.yml
#
# Note there is NO api key here. This topic drives the box through `midclt`
# over SSH, which authenticates as root on the box itself — SSH access IS the
# credential. See group_vars/all.yml for why REST (and therefore an API key)
# was deliberately not used.

# SMTP for alert email. A drive-failure alert you never configured is worthless
# (setup runbook, golden rule 5) — and on a 5-year-old drive cohort it is the
# single highest-value thing in this file.
# Mailjet is what this cluster uses; smtp.example.com below is generic.
#   server   in-v3.mailjet.com
#   port     587 with security TLS (TrueNAS calls STARTTLS "TLS"; 465 would be "SSL")
#   user     the Mailjet API KEY  -- NOT an email address
#   password the Mailjet SECRET KEY
truenas_smtp_server: smtp.example.com
truenas_smtp_port: 587
truenas_smtp_security: TLS
truenas_smtp_user: alerts@example.com
truenas_smtp_password: CHANGEME

# THE SENDER, SEPARATE FROM THE USERNAME, and on Mailjet they are NOT the same
# thing: the username is an API key. It must be a VALIDATED SENDER in the
# provider or mail is rejected silently -- the playbook converges, mail.config
# looks correct, and nothing ever arrives. Omit it and it falls back to
# truenas_smtp_user, which is right only where the username is an address.
truenas_smtp_from: alerts@example.com
# Optional display name; defaults to "TrueNAS <inventory_hostname>".
# truenas_smtp_fromname: TrueNAS truenas

# Where alerts go. TrueNAS has no "alert recipient" setting -- it mails whatever
# address the local ADMINISTRATOR ACCOUNTS carry, so this is written onto the
# users listed in truenas_alert_users. With SMTP configured but no user email,
# the UI refuses outright: "No e-mail address is set for root user or any other
# local administrator."
truenas_alert_to: you@example.com
# Which accounts receive them. `root` is what the UI checks first; add
# truenas_admin if you want both to carry it.
# truenas_alert_users: [root]

# ---- SMB (Time Machine) ---------------------------------------------------
# One password per Mac, matching `password_var` in truenas_smb_users.
#
# These are the ONLY reason the SMB role touches the vault. Everything else in
# it -- the global aapl_extensions flag, the groups, the dataset ACLs, the
# shares, the service -- converges without one, so the playbook stays runnable
# with no interactive prompt for routine changes. When the vault is absent the
# role SAYS SO per account rather than reporting a clean converged run that no
# Mac can actually log in to.
#
# The role re-asserts these on every run (it cannot compare against the stored
# NT hash), so rotating a value here and re-running is all a rotation takes.
truenas_smb_password_macmini: CHANGEME
truenas_smb_password_mba: CHANGEME
