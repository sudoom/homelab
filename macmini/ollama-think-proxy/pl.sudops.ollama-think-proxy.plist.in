<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills __PYTHON__, __DEST__ and __HOME__ and writes the result to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.sudops.ollama-think-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__DEST__/ollama-think-proxy.py</string>
    <string>--listen</string>
    <string>0.0.0.0:11435</string>
    <string>--upstream</string>
    <string>127.0.0.1:11434</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/ollama-think-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/ollama-think-proxy.log</string>
</dict>
</plist>
