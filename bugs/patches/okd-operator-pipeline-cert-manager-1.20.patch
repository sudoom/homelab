-RUN make build --warn-undefined-variables
+# Build the binary directly rather than via `make build`.
+#
+# From cert-manager-1.20 onward `make build` depends on the `generate` target,
+# which runs hack/update-clientgen.sh and needs k8s.io/code-generator. That is
+# not vendored, so with -mod=vendor the build fails:
+#   cannot find module providing package k8s.io/code-generator/cmd/client-gen:
