From 1705858e66528ae7f0ce4c071440041f6529221f Mon Sep 17 00:00:00 2001
From: Vadzim Dziadziulia <vadzim.dziadziulia@keemail.me>
Date: Tue, 8 Sep 2026 21:41:50 +0200
Subject: [PATCH 3/3] [cert-manager] Set the okderators upgrade graph on the
 bundle

The generated CSV carries Red Hat's upgrade graph, not okderators'. On 1.20 that
is olm.skipRange '>=1.19.0 <1.20.0' and replaces cert-manager-operator.v1.19.0 --
but okderators has never published a 1.19 build. Its history is 1.14.0, 1.15.0
and 1.18.0, so a cluster on the current head (1.18.0-2025-12-25-214537) falls
outside the range and is never offered the upgrade. Checked against the semver
library OLM resolves skipRange with:

  >=1.19.0 <1.20.0                    1.18.0-2025-12-25-214537 -> false
  >=1.0.0 <1.20.0-<date>              1.18.0-2025-12-25-214537 -> true

Widen the range to cover every published okderators build and drop the dangling
replaces, as kube-descheduler and vertical-pod-autoscaler already do.
---
 cert-manager/build.sh | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/cert-manager/build.sh b/cert-manager/build.sh
index 615908e..6896485 100755
--- a/cert-manager/build.sh
+++ b/cert-manager/build.sh
@@ -13,6 +13,8 @@ IMG_ISTIO_CSR="${REGISTRY}/istio-csr:${OCP_DATE}"
 
 IMG_BUNDLE="${REGISTRY}/operator-bundle:${OCP_DATE}"
 
+CSV_BASE="config/manifests/bases/cert-manager-operator.clusterserviceversion.yaml"
+
 init() {
     submodule_initialize istio-csr main
     submodule_initialize cert-manager release-${OCP_SHORT}
@@ -60,6 +62,19 @@ build_bundle() {
      .env |= map(select(.name == \"OPERATOR_IMAGE_VERSION\").value = \"${OCP_DATE}\")
     )" ./config/manager/manager.yaml
 
+    # The upstream CSV describes Red Hat's upgrade graph, not okderators'.
+    # It carries `olm.skipRange: '>=1.19.0 <1.20.0'` and
+    # `replaces: cert-manager-operator.v1.19.0`, but okderators has never
+    # published a 1.19 build -- its published history is 1.14.0, 1.15.0 and
+    # 1.18.0. Left as-is, the 1.20 bundle offers no upgrade edge any okderators
+    # user can take, so a cluster on 1.18.0 would simply never be offered it.
+    # Widen the range to cover every published okderators build and drop the
+    # dangling `replaces`, matching kube-descheduler and vertical-pod-autoscaler.
+    export OLM_SKIP_RANGE=">=1.0.0 <${OCP_DATE}"
+    yq e -i '.metadata.annotations["olm.skipRange"] = strenv(OLM_SKIP_RANGE)' "${CSV_BASE}"
+    yq e -i 'del(.spec.replaces)' "${CSV_BASE}"
+    yq e -i 'del(.spec.skips)' "${CSV_BASE}"
+
     make bundle BUNDLE_VERSION=${OCP_DATE} IMG=${IMG_OPERATOR} "BUNDLE_METADATA_OPTS=${BUNDLE_METADATA_OPTS}" \
      BUNDLE_IMG=${IMG_BUNDLE} CONTAINER_ENGINE=podman ISTIO_CSR_VERSION=${OCP_DATE}
 
-- 
2.50.1 (Apple Git-155)

