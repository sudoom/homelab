+--- a/Makefile
++++ b/Makefile
+@@ -21,10 +21,14 @@ export XDG_CONFIG_HOME ?= $(PROJECT_ROOT)/_output/.config
+ # DEFAULT_VERSION is the default version to use for image tags when not set.
+ DEFAULT_VERSION := 1.20.0
+ 
+-# Helper function to validate semver (Major.Minor.Patch format)
+-# Returns 'valid' if the version matches semver (X.Y.Z) or 'latest', empty string otherwise
++# Helper function to validate semver (Major.Minor.Patch[-prerelease] format)
++# Returns 'valid' if the version matches semver (X.Y.Z or X.Y.Z-prerelease) or
++# 'latest', empty string otherwise.
++# The pre-release suffix is permitted because it is part of the semver spec and
++# downstream rebuilds distinguish multiple builds of the same upstream version
++# that way (e.g. 1.20.0-2026-09-08-200000).
+ define validate-semver
+-$(shell echo '$(1)' | grep -Eq '^([0-9]+\.[0-9]+\.[0-9]+|latest)$$' && echo valid)
++$(shell echo '$(1)' | grep -Eq '^([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?|latest)$$' && echo valid)
+ endef
+ 
+ # Formats version for image tags: adds 'v' prefix for semver, keeps 'latest' as-is
