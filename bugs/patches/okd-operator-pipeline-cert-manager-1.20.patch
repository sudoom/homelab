+ENV GO_BUILD_TAGS=strictfipsruntime,openssl
+ENV GOEXPERIMENT=strictfipsruntime
+ENV CGO_ENABLED=1
+ENV GOFLAGS=""
+
+RUN go build -o cert-manager-operator -ldflags '-w -s' -tags "${GO_BUILD_TAGS}" main.go
 
