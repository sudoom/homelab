{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "kubernetes": {
    "fileMatch": [
      "components/.+\\.yaml$",
      "media/.+\\.yaml$",
      "keepers/.+\\.yaml$",
      "ai/.+\\.yaml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "components/.+values\\.yaml$"
    ]
  },
  "helmv3": {
    "fileMatch": [
      "components/.+Chart\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Automerge patch updates for media stack",
      "matchPaths": ["media/**", "keepers/**"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Group rook-ceph updates",
      "matchPackagePatterns": ["rook-ceph"],
      "groupName": "rook-ceph"
    },
    {
      "description": "Pin Jellyfin <10.11 — 10.11.x has an unfixed migrations.xml->EF-Core crash (CheckFirstTimeRunOrMigration unguarded .Last(); jellyfin/jellyfin#15388 under #15686, present through 10.11.11/master). Allows 10.10.x patches; blocks 10.11.x. Remove this rule once upstream guards the migration.",
      "matchPackageNames": ["lscr.io/linuxserver/jellyfin", "jellyfin/jellyfin"],
      "allowedVersions": "<10.11"
    }
  ],
  "ignorePaths": [
    "bootstrap/**",
    "*-values.yaml",
    "monitoring/**"
  ]
}
