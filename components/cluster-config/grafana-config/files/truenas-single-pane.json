{
  "title": "TrueNAS \u2014 single pane",
  "uid": "truenas-single-pane",
  "tags": [
    "truenas",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health at a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Exporter",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{job=\"truenas-exporter\"}",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "If this is 0 every other panel here is blind, including pool health."
    },
    {
      "id": 2,
      "title": "Pool health",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_healthy{pool=\"tank\"}",
          "legendFormat": "tank",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT OK",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "1 = ONLINE. RAIDZ2 survives two drive failures, but this is a wear-matched cohort."
    },
    {
      "id": 3,
      "title": "Pool used",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_capacity_ratio{pool=\"tank\"}",
          "legendFormat": "tank",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Backs media, keepers, Loki chunks and Velero backups. Filling it takes out logging and backups together."
    },
    {
      "id": 4,
      "title": "Days since scrub",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_scrub_age_seconds{pool=\"tank\"} / 86400",
          "legendFormat": "tank",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_scrub_ever{pool=\"tank\"}",
          "legendFormat": "ever scrubbed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 35
              },
              {
                "color": "red",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "NO DATA / 0 for 'ever scrubbed' means the pool has NEVER been scrubbed -- nothing has verified parity. Scrub is what detects bit rot so RAIDZ2 can heal it."
    },
    {
      "id": 5,
      "title": "Power draw",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (instance) (shelly_power_watts{instance=\"truenas\"})",
          "legendFormat": "truenas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "watt"
        },
        "overrides": []
      },
      "description": "From the Shelly plug. Shares instance=\"truenas\" with node_exporter -- the whole point of the single pane. avg by (instance) is required, not cosmetic: the shelly series FORKED before its pod/container labeldrop landed on 2026-09-08, so a window spanning that change still contains several series all labelled truenas."
    },
    {
      "id": 6,
      "title": "SMART collection",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_read_ok",
          "legendFormat": "read ok",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_scanned",
          "legendFormat": "scanned",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Health of the COLLECTION, not of the disks -- this is how many disks the collector could read, out of how many `smartctl --scan` found. The disks' own health is the table in the Disks row below. read_ok below scanned means the cron stopped running as root and drive health is unmonitored (it read 0 of 7 during development for exactly that reason)."
    },
    {
      "id": 101,
      "type": "row",
      "title": "Capacity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Pool capacity trend",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_capacity_ratio",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Long-horizon view; this is the number to extrapolate before buying disks."
    },
    {
      "id": 11,
      "title": "Dataset used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_dataset_used_bytes{dataset!~\".*@.*\"}",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Which dataset is actually growing. boot-pool and the .system/ix-apps trees are deliberately excluded by the collector."
    },
    {
      "id": 105,
      "type": "row",
      "title": "System",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 50,
      "title": "CPU utilisation",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=\"truenas\",mode=\"idle\"}[5m]))",
          "legendFormat": "busy",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{instance=\"truenas\",mode=~\"iowait|system\"}[5m])) / on() group_left count(count by (cpu) (node_cpu_seconds_total{instance=\"truenas\"}))",
          "legendFormat": "{{mode}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "`busy` is 1 - idle across all cores. iowait and system are broken out because on a NAS they are the interesting ones: sustained iowait means the disks, not the CPU, are the constraint."
    },
    {
      "id": 51,
      "title": "Load average",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_load1{instance=\"truenas\"}",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_load5{instance=\"truenas\"}",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_load15{instance=\"truenas\"}",
          "legendFormat": "15m",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (cpu) (node_cpu_seconds_total{instance=\"truenas\"}))",
          "legendFormat": "cores",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Compare against the `cores` line, not against zero: load equal to the core count is fully busy, not overloaded. On ZFS a scrub or resilver drives load up legitimately."
    },
    {
      "id": 52,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemTotal_bytes{instance=\"truenas\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemAvailable_bytes{instance=\"truenas\"}",
          "legendFormat": "available",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_zfs_arc_size{instance=\"truenas\"}",
          "legendFormat": "ARC",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemTotal_bytes{instance=\"truenas\"} - node_memory_MemAvailable_bytes{instance=\"truenas\"} - node_zfs_arc_size{instance=\"truenas\"}",
          "legendFormat": "used (excl. ARC)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "READ THIS BEFORE PANICKING ABOUT `available`. ZFS ARC is not Linux page cache, so it counts as USED and MemAvailable does NOT include it -- at survey time this box read 8.1 GiB available of 33.6 GiB, while 25 GiB of the difference was ARC, which is reclaimable on demand. `used (excl. ARC)` is the number that actually reflects pressure. Low available with a large ARC is ZFS working correctly, not a leak."
    },
    {
      "id": 53,
      "title": "Scrub progress",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_scrub_percent_complete{pool=\"tank\"}",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Only populated while a scrub is running. Scrub is what verifies parity so RAIDZ2 can heal bit rot; on this six-drive cohort of ~43,700-hour pulls it is the single most valuable periodic operation."
    },
    {
      "id": 102,
      "type": "row",
      "title": "ZFS behaviour",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "ARC hit ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_arc_hits{instance=\"truenas\"}[5m]) / (rate(node_zfs_arc_hits{instance=\"truenas\"}[5m]) + rate(node_zfs_arc_misses{instance=\"truenas\"}[5m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Sustained low hit ratio on a read-heavy workload is the argument for more RAM."
    },
    {
      "id": 21,
      "title": "ARC size",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_zfs_arc_size{instance=\"truenas\"}",
          "legendFormat": "arc size",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_zfs_arc_c_max{instance=\"truenas\"}",
          "legendFormat": "c_max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "ZIL commits/s",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_zil_zil_commit_count{instance=\"truenas\"}[5m])",
          "legendFormat": "zil_commit/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_zil_zil_commit_writer_count{instance=\"truenas\"}[5m])",
          "legendFormat": "writer/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Synchronous-write rate. This is the standing version of the one-off SLOG study: a high sustained rate is the case for a dedicated SLOG device."
    },
    {
      "id": 103,
      "type": "row",
      "title": "Disks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Drive temperature",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_temperature_celsius",
          "legendFormat": "{{serial}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 45
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Keyed by SERIAL, not /dev/sdX -- device names re-enumerate on any reseat. node_exporter's own hwmon temps are labelled by SCSI target and cannot be mapped to a physical disk."
    },
    {
      "id": 31,
      "title": "Reallocated / pending sectors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_reallocated_sectors",
          "legendFormat": "{{serial}} realloc",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_pending_sectors",
          "legendFormat": "{{serial}} pending",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "These are 43k-hour datacenter pulls: a NON-ZERO count is normal and expected. A count that MOVES is the failure signal."
    },
    {
      "id": 32,
      "title": "SMART, per disk",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_healthy{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_temperature_celsius{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_power_on_hours{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_reallocated_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_pending_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_uncorrectable_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "description": "How to read this. SMART = the drive's own overall self-assessment; FAIL means it is predicting its own failure and should be replaced now. Reallocated (attr 5) = sectors already remapped to spares. Pending (197) = sectors that failed a read and are waiting to be remapped -- this is the MORE urgent of the two, because it is data currently at risk rather than damage already contained. Uncorrectable (198) = sectors that could not be recovered at all. On this box a NON-ZERO count is not automatically alarming: these are 43,000-hour datacenter pulls and they arrived with a history. What matters is a count that MOVES -- hence the alert uses delta() over 24h rather than a threshold. Keyed by SERIAL, never /dev/sdX, because device names re-enumerate on any reseat.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "serial",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "endpoint": true,
              "namespace": true,
              "service": true,
              "container": true,
              "pod": true,
              "instance": true,
              "device": true,
              "prometheus": true,
              "prometheus_replica": true,
              "Time A": true,
              "Time B": true,
              "Time C": true,
              "Time D": true,
              "Time E": true,
              "Time F": true
            },
            "renameByName": {
              "serial": "Serial",
              "model": "Model",
              "Value #A": "SMART",
              "Value #B": "Temp \u00b0C",
              "Value #C": "Power-on hours",
              "Value #D": "Reallocated (5)",
              "Value #E": "Pending (197)",
              "Value #F": "Uncorrectable (198)"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SMART"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAIL",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "PASS",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(Reallocated|Pending|Uncorrectable).*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temp \u00b0C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 45
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    },
