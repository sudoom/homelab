{
  "title": "TrueNAS \u2014 single pane",
  "uid": "truenas-single-pane",
  "tags": [
    "truenas",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health at a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Exporter",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{job=\"truenas-exporter\"}",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "If this is 0 every other panel here is blind, including pool health."
    },
    {
      "id": 2,
      "title": "Pool health",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_healthy{pool=\"tank\"}",
          "legendFormat": "tank",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT OK",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "1 = ONLINE. RAIDZ2 survives two drive failures, but this is a wear-matched cohort."
    },
    {
      "id": 3,
      "title": "Pool used",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_capacity_ratio{pool=\"tank\"}",
          "legendFormat": "tank",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Backs media, keepers, Loki chunks and Velero backups. Filling it takes out logging and backups together."
    },
    {
      "id": 4,
      "title": "Days since scrub",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_scrub_age_seconds{pool=\"tank\"} / 86400",
          "legendFormat": "tank",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_scrub_ever{pool=\"tank\"}",
          "legendFormat": "ever scrubbed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 35
              },
              {
                "color": "red",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "NO DATA / 0 for 'ever scrubbed' means the pool has NEVER been scrubbed -- nothing has verified parity. Scrub is what detects bit rot so RAIDZ2 can heal it."
    },
    {
      "id": 5,
      "title": "Power draw",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (instance) (shelly_power_watts{instance=\"truenas\"})",
          "legendFormat": "truenas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "watt"
        },
        "overrides": []
      },
      "description": "From the Shelly plug. Shares instance=\"truenas\" with node_exporter -- the whole point of the single pane. avg by (instance) is required, not cosmetic: the shelly series FORKED before its pod/container labeldrop landed on 2026-09-08, so a window spanning that change still contains several series all labelled truenas."
    },
    {
      "id": 6,
      "title": "SMART collection",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_read_ok",
          "legendFormat": "read ok",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_scanned",
          "legendFormat": "scanned",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Health of the COLLECTION, not of the disks -- this is how many disks the collector could read, out of how many `smartctl --scan` found. The disks' own health is the table in the Disks row below. read_ok below scanned means the cron stopped running as root and drive health is unmonitored (it read 0 of 7 during development for exactly that reason)."
    },
    {
      "id": 101,
      "type": "row",
      "title": "Capacity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Pool capacity trend",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_zpool_capacity_ratio",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Long-horizon view; this is the number to extrapolate before buying disks."
    },
    {
      "id": 11,
      "title": "Dataset used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_dataset_used_bytes{dataset!~\".*@.*\"}",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Which dataset is actually growing. boot-pool and the .system/ix-apps trees are deliberately excluded by the collector."
    },
    {
      "id": 102,
      "type": "row",
      "title": "ZFS behaviour",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "ARC hit ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_arc_hits{instance=\"truenas\"}[5m]) / (rate(node_zfs_arc_hits{instance=\"truenas\"}[5m]) + rate(node_zfs_arc_misses{instance=\"truenas\"}[5m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Sustained low hit ratio on a read-heavy workload is the argument for more RAM."
    },
    {
      "id": 21,
      "title": "ARC size",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_zfs_arc_size{instance=\"truenas\"}",
          "legendFormat": "arc size",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_zfs_arc_c_max{instance=\"truenas\"}",
          "legendFormat": "c_max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "ZIL commits/s",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_zil_zil_commit_count{instance=\"truenas\"}[5m])",
          "legendFormat": "zil_commit/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_zfs_zil_zil_commit_writer_count{instance=\"truenas\"}[5m])",
          "legendFormat": "writer/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Synchronous-write rate. This is the standing version of the one-off SLOG study: a high sustained rate is the case for a dedicated SLOG device."
    },
    {
      "id": 103,
      "type": "row",
      "title": "Disks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Drive temperature",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_temperature_celsius",
          "legendFormat": "{{serial}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 45
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Keyed by SERIAL, not /dev/sdX -- device names re-enumerate on any reseat. node_exporter's own hwmon temps are labelled by SCSI target and cannot be mapped to a physical disk."
    },
    {
      "id": 31,
      "title": "Reallocated / pending sectors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_reallocated_sectors",
          "legendFormat": "{{serial}} realloc",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_pending_sectors",
          "legendFormat": "{{serial}} pending",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "These are 43k-hour datacenter pulls: a NON-ZERO count is normal and expected. A count that MOVES is the failure signal."
    },
    {
      "id": 32,
      "title": "SMART, per disk",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_smart_healthy{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_temperature_celsius{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_power_on_hours{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_reallocated_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_pending_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "truenas_disk_uncorrectable_sectors{instance=\"truenas\"}",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "description": "How to read this. SMART = the drive's own overall self-assessment; FAIL means it is predicting its own failure and should be replaced now. Reallocated (attr 5) = sectors already remapped to spares. Pending (197) = sectors that failed a read and are waiting to be remapped -- this is the MORE urgent of the two, because it is data currently at risk rather than damage already contained. Uncorrectable (198) = sectors that could not be recovered at all. On this box a NON-ZERO count is not automatically alarming: these are 43,000-hour datacenter pulls and they arrived with a history. What matters is a count that MOVES -- hence the alert uses delta() over 24h rather than a threshold. Keyed by SERIAL, never /dev/sdX, because device names re-enumerate on any reseat.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "serial",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "endpoint": true,
              "namespace": true,
              "service": true,
              "container": true,
              "pod": true,
              "instance": true,
              "device": true,
              "prometheus": true,
              "prometheus_replica": true,
              "Time A": true,
              "Time B": true,
              "Time C": true,
              "Time D": true,
              "Time E": true,
              "Time F": true
            },
            "renameByName": {
              "serial": "Serial",
              "model": "Model",
              "Value #A": "SMART",
              "Value #B": "Temp \u00b0C",
              "Value #C": "Power-on hours",
              "Value #D": "Reallocated (5)",
              "Value #E": "Pending (197)",
              "Value #F": "Uncorrectable (198)"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SMART"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAIL",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "PASS",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(Reallocated|Pending|Uncorrectable).*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temp \u00b0C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 45
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "NFS + network",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
